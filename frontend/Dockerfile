# ── Stage 1: Install dependencies ────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
RUN corepack enable
COPY package.json .yarnrc.yml* yarn.lock* ./
RUN yarn install

# ── Stage 2: Build Vite app ───────────────────────────────────────────────────
# Vite bakes VITE_* into the bundle at build time. Railway passes service vars as
# build args, but Docker IGNORES undeclared ARGs — so each VITE_* must be declared
# ARG and promoted to ENV here for `yarn build` to see it. Keep in sync with the
# VITE_* set on the Railway Frontend service.
FROM deps AS builder
ARG VITE_API_BASE_URL
ARG VITE_WALLETCONNECT_PROJECT_ID
ARG VITE_WALLETCONNECT_PROJECT_ID_2
ARG VITE_WALLETCONNECT_PROJECT_ID_3
ARG VITE_WALLETCONNECT_PROJECT_ID_4
ARG VITE_SOLANA_CLUSTER
ARG VITE_SOLANA_RPC_URL_DEVNET
ARG VITE_SOLANA_RPC_URL_MAINNET
ARG VITE_SOLANA_RPC_URL_MAINNET_2
ARG VITE_SOLANA_RPC_URL_MAINNET_3
ARG VITE_SOLANA_RPC_URL_MAINNET_4
ARG VITE_SOLANA_RPC_URL_MAINNET_5
ARG VITE_SOLANA_RPC_URL_TESTNET
ARG VITE_USDT_MINT
ARG VITE_USDT_MINT_DEVNET
ARG VITE_ADMIN_ADDRESS
ARG VITE_DEV_ADDRESS
ARG VITE_MARKETER1_ADDRESS
ARG VITE_MARKETER2_ADDRESS
ARG VITE_DEFAULT_SPONSOR_ADDRESS
ARG VITE_SOLAIRUS_MAIN_PROGRAM_ID
ARG VITE_CMC_API_KEY
ARG VITE_AGENT_CARDS_DESKTOP
ARG VITE_AGENT_CARDS_MOBILE
ARG VITE_AGENT_CARDS_TABLET
ARG VITE_AGENT_CARDS_WIDE
ARG VITE_AGENT_REFRESH_INTERVAL
ARG VITE_OUTCOME_ROWS
ARG VITE_WITHDRAWAL_STATUS_REFRESH_INTERVAL
ARG VITE_ENABLE_AGENT_MOCK_DATA
ARG VITE_ENABLE_ERROR_REPORTING
ARG VITE_ENABLE_LICENSE_GUARD
ARG VITE_ENABLE_WALLET_GUARD
ARG VITE_SHOW_COMING_SOON
ARG VITE_SHOW_DETAILED_ERRORS
ARG VITE_SIMULATE_NETWORK_DELAY
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_WALLETCONNECT_PROJECT_ID=$VITE_WALLETCONNECT_PROJECT_ID \
    VITE_WALLETCONNECT_PROJECT_ID_2=$VITE_WALLETCONNECT_PROJECT_ID_2 \
    VITE_WALLETCONNECT_PROJECT_ID_3=$VITE_WALLETCONNECT_PROJECT_ID_3 \
    VITE_WALLETCONNECT_PROJECT_ID_4=$VITE_WALLETCONNECT_PROJECT_ID_4 \
    VITE_SOLANA_CLUSTER=$VITE_SOLANA_CLUSTER \
    VITE_SOLANA_RPC_URL_DEVNET=$VITE_SOLANA_RPC_URL_DEVNET \
    VITE_SOLANA_RPC_URL_MAINNET=$VITE_SOLANA_RPC_URL_MAINNET \
    VITE_SOLANA_RPC_URL_MAINNET_2=$VITE_SOLANA_RPC_URL_MAINNET_2 \
    VITE_SOLANA_RPC_URL_MAINNET_3=$VITE_SOLANA_RPC_URL_MAINNET_3 \
    VITE_SOLANA_RPC_URL_MAINNET_4=$VITE_SOLANA_RPC_URL_MAINNET_4 \
    VITE_SOLANA_RPC_URL_MAINNET_5=$VITE_SOLANA_RPC_URL_MAINNET_5 \
    VITE_SOLANA_RPC_URL_TESTNET=$VITE_SOLANA_RPC_URL_TESTNET \
    VITE_USDT_MINT=$VITE_USDT_MINT \
    VITE_USDT_MINT_DEVNET=$VITE_USDT_MINT_DEVNET \
    VITE_ADMIN_ADDRESS=$VITE_ADMIN_ADDRESS \
    VITE_DEV_ADDRESS=$VITE_DEV_ADDRESS \
    VITE_MARKETER1_ADDRESS=$VITE_MARKETER1_ADDRESS \
    VITE_MARKETER2_ADDRESS=$VITE_MARKETER2_ADDRESS \
    VITE_DEFAULT_SPONSOR_ADDRESS=$VITE_DEFAULT_SPONSOR_ADDRESS \
    VITE_SOLAIRUS_MAIN_PROGRAM_ID=$VITE_SOLAIRUS_MAIN_PROGRAM_ID \
    VITE_CMC_API_KEY=$VITE_CMC_API_KEY \
    VITE_AGENT_CARDS_DESKTOP=$VITE_AGENT_CARDS_DESKTOP \
    VITE_AGENT_CARDS_MOBILE=$VITE_AGENT_CARDS_MOBILE \
    VITE_AGENT_CARDS_TABLET=$VITE_AGENT_CARDS_TABLET \
    VITE_AGENT_CARDS_WIDE=$VITE_AGENT_CARDS_WIDE \
    VITE_AGENT_REFRESH_INTERVAL=$VITE_AGENT_REFRESH_INTERVAL \
    VITE_OUTCOME_ROWS=$VITE_OUTCOME_ROWS \
    VITE_WITHDRAWAL_STATUS_REFRESH_INTERVAL=$VITE_WITHDRAWAL_STATUS_REFRESH_INTERVAL \
    VITE_ENABLE_AGENT_MOCK_DATA=$VITE_ENABLE_AGENT_MOCK_DATA \
    VITE_ENABLE_ERROR_REPORTING=$VITE_ENABLE_ERROR_REPORTING \
    VITE_ENABLE_LICENSE_GUARD=$VITE_ENABLE_LICENSE_GUARD \
    VITE_ENABLE_WALLET_GUARD=$VITE_ENABLE_WALLET_GUARD \
    VITE_SHOW_COMING_SOON=$VITE_SHOW_COMING_SOON \
    VITE_SHOW_DETAILED_ERRORS=$VITE_SHOW_DETAILED_ERRORS \
    VITE_SIMULATE_NETWORK_DELAY=$VITE_SIMULATE_NETWORK_DELAY
COPY . .
RUN yarn build

# ── Stage 3: Serve with Caddy ─────────────────────────────────────────────────
# Caddy binds Railway's injected $PORT (Caddyfile: :{$PORT:80}). The Frontend
# service must set PORT=8080 to match the public domain's targetPort.
FROM caddy:2-alpine AS runner
COPY --from=builder /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
