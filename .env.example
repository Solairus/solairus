VITE_OUTCOME_ROWS=7
# Obtain from CMC dashboard; keep private and out of repo
VITE_CMC_API_KEY=YOUR_CMC_API_KEY
# Optional: control home overlay countdown
# VITE_COUNTDOWN_TARGET=2025-10-09T20:39:43.902Z
# Solana cluster: one of 'devnet', 'testnet', or 'mainnet-beta'
VITE_SOLANA_CLUSTER=devnet
# WalletConnect Cloud Project ID for QR-based wallet connection (optional)
# Sign up at https://cloud.walletconnect.com to obtain this value
VITE_WALLETCONNECT_PROJECT_ID=
# Toggle wallet guard on dApp pages. When set to 'false',
# dApp pages render without requiring a wallet connection and
# components may use a preview fallback address for display.
VITE_ENABLE_WALLET_GUARD=true

# Optional: show coming soon banner/features during development
VITE_SHOW_COMING_SOON=false

# Default sponsor address used when no referral is present or expired
VITE_DEFAULT_SPONSOR_ADDRESS=

# Admin role addresses for admin interface access
VITE_ADMIN_ADDRESS=
VITE_DEV_ADDRESS=
VITE_MARKETER1_ADDRESS=
VITE_MARKETER2_ADDRESS=

# Agent system configuration
# Enable/disable agent dashboard and tier selection features
VITE_ENABLE_AGENT_DASHBOARD=true
VITE_ENABLE_TIER_SELECTION=true
VITE_ENABLE_WITHDRAWAL_LIMITS=true

# Agent service configuration
# Refresh intervals for agent data (in milliseconds)
VITE_AGENT_REFRESH_INTERVAL=30000
VITE_WITHDRAWAL_STATUS_REFRESH_INTERVAL=5000

# Agent UI configuration
# Number of agent cards per row on different screen sizes
VITE_AGENT_CARDS_MOBILE=1
VITE_AGENT_CARDS_TABLET=2
VITE_AGENT_CARDS_DESKTOP=3
VITE_AGENT_CARDS_WIDE=4

# Error handling configuration
# Enable detailed error messages in development
VITE_SHOW_DETAILED_ERRORS=true
# Enable error reporting to external service (production)
VITE_ENABLE_ERROR_REPORTING=false

# Development/testing features
# Enable mock data for agent testing (development only)
VITE_ENABLE_AGENT_MOCK_DATA=false
# Simulate network delays for testing (development only)
VITE_SIMULATE_NETWORK_DELAY=false