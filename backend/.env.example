# Backend environment template — copy to .env and fill real values.
# .env and .env.* are gitignored; THIS .env.example is the tracked template (never put secrets here).

# ── Database ──
# Set automatically by docker-compose for the container. Needed for running
# scripts (migrate / seed) from the host against the exposed Postgres:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/solairus

# ── Auth (compose sets these for local Docker) ──
JWT_SECRET=change_me
CRON_SECRET=change_me

# ── Treasury / hot wallet: sweep target + payout source + sweep fee payer ──
# base58-encoded 64-byte secret key. Keep funded with SOL for fees.
SOLAIRUS_AUTHORITY_SECRET_BASE58=

# ── HD wallet: derives a unique deposit address per order (BIP44 m/44'/501'/<index>'/0') ──
# 12- or 24-word BIP39 phrase. BACK THIS UP — losing it makes deposit addresses unrecoverable.
HD_WALLET_MNEMONIC=

# ── USDT SPL mint + cluster (MUST match each other) ──
# mainnet USDT:
USDT_MINT_ADDRESS=Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
SOLANA_CLUSTER=mainnet-beta
# devnet example:
# USDT_MINT_ADDRESS=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr
# SOLANA_CLUSTER=devnet

# ── License settings seed (scripts/seed-settings.js); fee in WHOLE USDT ──
LICENSE_FEE_USDT=25
LICENSE_TERM_DAYS=365

# ── Optional tuning (defaults shown) ──
# ORDER_POLL_INTERVAL_MS=15000     # monitor poll cadence
# ORDER_TTL_MS=3600000             # license/agent payment window (60 min)
# DEPOSIT_TTL_MS=86400000          # deposit window (24 h)
# SWEEP_MIN_TOLERANCE_BPS=50       # accept balance >= expected * (1 - 0.5%)

# ── Admin (license-exempt; may call admin endpoints) ──
# ADMIN_PUBKEY=
# ADMIN_PUBKEYS=
