# Backend environment configuration
# Copy to .env and set values

# Postgres connection, e.g. postgres://user:password@localhost:5432/solairus
DATABASE_URL=

# Optional: Solana RPC (defaults to devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Server port
PORT=4000

# JWT secret for signing tokens
JWT_SECRET=change_me_please

# Authority key (do NOT commit real secrets)
# Preferred: base58-encoded secret key (64-byte)
SOLAIRUS_AUTHORITY_SECRET_BASE58=
# Fallback: path to JSON keypair file (chmod 600)
# SOLAIRUS_AUTHORITY_KEYPAIR_PATH=/Users/you/.config/solana/solairus_authority.json